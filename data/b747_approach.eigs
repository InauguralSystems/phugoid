# Boeing 747, Mach 0.25 powered approach, standard sea level.
# Machine-readable copy of DERIVATIVES.md — sources and units live there.
# The nondimensional coefficients + flight condition are the PRIMARY data;
# everything downstream (dimensional derivatives, A matrices, quartics,
# roots, mode quantities) is derived by modes.eigs and checked against the
# published values recorded in tests/modes_check.eigs.

define b747_approach as:
    local cond is {
        "u0": 279.1,
        "rho": 0.002377,
        "S": 5500.0,
        "cbar": 27.3,
        "b": 195.7,
