# measure_check.eigs — the M1..M3 estimator checks from ORACLE.md, on
# synthetic signals with known truth.
# Run from the repo root:  eigenscript tests/measure_check.eigs [plant]
# where plant is p4 (generator time-dilated +5% vs declared truth, decay
# rates included), p5 (damping estimate replaced by a constant 0.05), or
# p7 (every refusal result forced to ok=1), or p10 (every DFT result
# forced into a refusal, exercising the refusal arm of check_result).
# Prints PASS/FAIL lines, then CHECKS_RUN / FAILURES; exits nonzero on any
# failure; the check population is pinned at exactly 53.

load_file of "measure.eigs"
load_file of "tests/checklib.eigs"

cli is args of null
plant is ""
if (len of cli) > 0:
    plant is cli[0]

checks_run is 0
failures is 0

# Comparator core lives in tests/checklib.eigs (boundary-self-tested).
define check_rel(name, ours, truth, reltol) as:
    checks_run is checks_run + 1
    if (rel_tol_ok of [ours, truth, reltol]) == 1:
        print of f"PASS {name} ours={ours} truth={truth}"
    else:
        failures is failures + 1
        print of f"FAIL {name} ours={ours} truth={truth} reltol={reltol}"

# Plant p7 forces every refusal result to ok=1 — it must redden all eight
# M3 checks and nothing else (round-3 review gutted check_refused itself
# and the suite stayed green; now the planted matrix exercises it).
define force_ok_if_p7(res) as:
    if plant == "p7":
        return {"ok": 1}
    return res

define check_refused(name, res) as:
    checks_run is checks_run + 1
    if res.ok == 0:
        print of f"PASS {name} refused: {res.reason}"
    else:
        failures is failures + 1
        print of f"FAIL {name} expected a refusal, got ok=1"

define check_result(name, res, field, truth, reltol) as:
    if res.ok == 1:
        check_rel of [name, res[field], truth, reltol]
    else:
        checks_run is checks_run + 1
        failures is failures + 1
        print of f"FAIL {name} estimator refused: {res.reason}"

# Damped sinusoid with declared truth zeta/wn. detune > 1 dilates time so
# the ACTUAL period exceeds the declared one while zeta stays exact — the
# shape plant p4 uses to hit the period checks alone.
define gen_osc(zeta, wn, phi, dc, dt, n, detune) as:
    local wd is wn * (sqrt of (1.0 - zeta * zeta)) / detune
    local sigma is zeta * wn / detune
    local out is []
    for i in range of n:
        local t is i * dt
        append of [out, dc + (exp of (0.0 - sigma * t)) * (cos of (wd * t + phi))]
    return out

define gen_exp(sigma, dt, n) as:
    local out is []
    for i in range of n:
        append of [out, exp of (0.0 - sigma * i * dt)]
    return out

detune is 1.0
if plant == "p4":
    detune is 1.05

# name, zeta, wn, phi, dc, dt, n, dft_T_reltol, zeta_reltol, peaks_T_reltol
# The peaks tolerance (0.1%) is deliberately tighter than the estimator's
# 1% guarantee: it pins the parabolic peak refinement, whose removal was
# measured at +0.33% error (round-2 review found the 1% checks let that
# mutation survive) while the refined estimator measures <= 0.043%.
# The zeta tolerance (0.5%) likewise pins the exact log-decrement
# conversion delta/sqrt(4pi^2+delta^2): round-5 review gutted it to the
# small-angle delta/2pi (+4.83% at zeta=0.30) and the old 5% rows let it
# through; measured estimator error is <= 0.013%, so 0.5% has 38x margin.
cases is [["ph_phase0", 0.013, 0.134, 0.0, 0.0, 1.0, 470, 0.01, 0.005, 0.001], ["ph_phase1", 0.013, 0.134, 1.0, 0.0, 1.0, 470, 0.01, 0.005, 0.001], ["dr_phase0", 0.107, 0.7477, 0.0, 0.0, 0.2, 430, 0.01, 0.005, 0.001], ["dr_phase1", 0.107, 0.7477, 1.0, 0.0, 0.2, 430, 0.01, 0.005, 0.001], ["dr_dc", 0.107, 0.7477, 0.0, 2.0, 0.2, 430, 0.01, 0.005, 0.001], ["mid_z30", 0.30, 1.0, 0.0, 0.0, 0.1, 400, 0.02, 0.005, 0.001], ["dr_phi2", 0.107, 0.7477, 2.0, 0.0, 0.2, 430, 0.01, 0.005, 0.001], ["dr_phi45", 0.107, 0.7477, 4.5, 0.0, 0.2, 430, 0.01, 0.005, 0.001], ["dr_n360", 0.107, 0.7477, 0.0, 0.0, 0.2, 360, 0.01, 0.005, 0.001], ["z30_phi15", 0.30, 1.0, 1.5, 0.0, 0.1, 400, 0.02, 0.005, 0.001], ["z30_phi25", 0.30, 1.0, 2.5, 0.0, 0.1, 400, 0.02, 0.005, 0.001], ["dr_4cyc", 0.107, 0.7477, 0.0, 0.0, 0.2, 170, 0.01, 0.005, 0.001], ["dr_bin3", 0.107, 0.7477, 0.0, 0.0, 0.2, 140, 0.01, 0.005, 0.001], ["dr_dcneg", 0.107, 0.7477, 0.0, 0.0 - 2.0, 0.2, 430, 0.01, 0.005, 0.001]]
# dr_bin3 (3.31 cycles, spectral peak in bin 3) pins the DFT acceptance
# boundary AT the declared constant: round-8 review drifted 3 -> 4 and the
# dr_4cyc row (bin 4) could not see it. dr_dcneg pins detrending for a
# NEGATIVE baseline: round-8 gutted detrend to identity and the dc=+2 row
# stayed green (the positive amplitude floor in find_peaks tolerates a
# positive offset without detrending; a negative one it does not).
# The dr_4cyc row (4.02 cycles in window) pins the DFT acceptance boundary
# from ABOVE: round-7 review drifted the 3-cycle refusal constant to 5 and
# every check stayed green — the refusal rows pin only the downward drift,
# and every accepting row sat at 6+ cycles, so a 3-5-cycle in-regime signal
# could be silently refused.
# The z30_phi15/z30_phi25 rows exist because round-3 review demonstrated
# the global-peak DFT falsely REFUSING at zeta=0.30 off-grid phases (the
# envelope leakage skirt beat the mode peak) — the zeta=0.30 claim is now
# tested across phase, on the local-max picker that fixed it.
# The dr_phi2/dr_phi45/dr_n360 rows exist because round-1 blind review
# demonstrated the unwindowed DFT breaking its 1% claim exactly at off-grid
# phases and window lengths — the grid now covers the space the claim spans.

unobserved:
    for c in cases:
        local name is c[0]
        local zeta is c[1]
        local wn is c[2]
        local sig is gen_osc of [zeta, wn, c[3], c[4], c[5], c[6], detune]
        local t_true is 2.0 * (pi of null) / (wn * (sqrt of (1.0 - zeta * zeta)))
        local dt is c[5]
        local rp is period_peaks of [sig, dt]
        check_result of [f"M1.peaks.{name}", rp, "T", t_true, c[9]]
        local rd is period_dft of [sig, dt]
        # Plant p10: every DFT result forced into a refusal — the M1.dft
        # checks must go red THROUGH the refusal arm of check_result, which
        # round-8 review gutted to print PASS with nothing noticing (no
        # clean run or plant had ever driven a refusal through it).
        if plant == "p10":
            rd is {"ok": 0, "reason": "planted refusal"}
        check_result of [f"M1.dft.{name}", rd, "T", t_true, c[7]]
        local rz is zeta_logdec of [sig, dt]
        if plant == "p5":
            rz is {"ok": 1, "zeta": 0.05}
        check_result of [f"M2.logdec.{name}", rz, "zeta", zeta, c[8]]

    # Heavy damping: the short-period regime, envelope fit (ORACLE M2).
    local hsig is gen_osc of [0.6255, 0.882, 0.0, 0.0, 0.05, 400, detune]
    local rh is zeta_envelope of [hsig, 0.05]
    if plant == "p5":
        rh is {"ok": 1, "zeta": 0.05}
    check_result of ["M2.envelope.heavy", rh, "zeta", 0.6255, 0.10]

    # Aperiodic decays at the published roll and spiral rates (ORACLE M2).
    # gen_exp divided by detune: plant p4 dilates the decay too, so the
    # M2.thalf checks are provably capable of failing (round-3 review found
    # no plant could redden them).
    local roll_sig is gen_exp of [1.2308 / detune, 0.01, 500]
    local r1 is t_half_exp of [roll_sig, 0.01]
    check_result of ["M2.thalf.roll", r1, "t_half", 0.563155, 0.02]
    local spiral_sig is gen_exp of [0.04641 / detune, 0.25, 500]
    local r2 is t_half_exp of [spiral_sig, 0.25]
    check_result of ["M2.thalf.spiral", r2, "t_half", 14.9346, 0.02]

    # M3 — honesty: every estimator's refusal paths are pinned (round-2
    # review demonstrated the unpinned ones surviving a gutting mutation).
    # A window holding under one cycle:
    local shortsig is gen_osc of [0.107, 0.7477, 0.0, 0.0, 0.2, 25, 1.0]
    check_refused of ["M3.refuse.peaks", force_ok_if_p7 of (period_peaks of [shortsig, 0.2])]
    check_refused of ["M3.refuse.dft", force_ok_if_p7 of (period_dft of [shortsig, 0.2])]
    check_refused of ["M3.refuse.logdec", force_ok_if_p7 of (zeta_logdec of [shortsig, 0.2])]
    # The DFT's declared 3-cycle boundary itself: ~2.5 cycles must refuse.
    local sig25 is gen_osc of [0.107, 0.7477, 0.0, 0.0, 0.2, 105, 1.0]
    check_refused of ["M3.refuse.dft_2cycles", force_ok_if_p7 of (period_dft of [sig25, 0.2])]
    # The DFT's minimum-length path.
    local sig6 is gen_osc of [0.107, 0.7477, 0.0, 0.0, 0.2, 6, 1.0]
    check_refused of ["M3.refuse.dft_short", force_ok_if_p7 of (period_dft of [sig6, 0.2])]
    # Envelope fit on a truncated heavy-damping window (< 3 spans).
    local htrunc is gen_osc of [0.6255, 0.882, 0.0, 0.0, 0.05, 150, 1.0]
    check_refused of ["M3.refuse.envelope", force_ok_if_p7 of (zeta_envelope of [htrunc, 0.05])]
    # Exponential fit: too few samples, and a growing (non-decaying) signal.
    local tiny is gen_exp of [1.2308, 0.01, 5]
    check_refused of ["M3.refuse.thalf_short", force_ok_if_p7 of (t_half_exp of [tiny, 0.01])]
    local growing is gen_exp of [0.0 - 1.0, 0.01, 100]
    check_refused of ["M3.refuse.thalf_growing", force_ok_if_p7 of (t_half_exp of [growing, 0.01])]

print of f"CHECKS_RUN {checks_run}"
print of f"FAILURES {failures}"
if checks_run != 53:
    print of f"FAIL harness: expected exactly 53 checks, ran {checks_run}"
    exit of 1
if failures > 0:
    exit of 1
