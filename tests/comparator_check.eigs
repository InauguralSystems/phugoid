# comparator_check.eigs — boundary self-test of tests/checklib.eigs.
# For every tolerance arm: a value JUST INSIDE must pass and a value JUST
# OUTSIDE must fail. A widened (or narrowed) tolerance flips one of these.
# Run from the repo root: eigenscript tests/comparator_check.eigs
# Population pinned at exactly 13.

load_file of "tests/checklib.eigs"

checks_run is 0
failures is 0

define expect(name, got, want) as:
    checks_run is checks_run + 1
    if got == want:
        print of f"PASS {name}"
    else:
        failures is failures + 1
        print of f"FAIL {name} got={got} want={want}"

# pub rule, relative arm dominant (printed=1.0: rel bound 1.5e-3 > abs 7e-5)
expect of ["pub.rel.inside", pub_tol_ok of [1.0014, 1.0, 4], 1]
expect of ["pub.rel.outside", pub_tol_ok of [1.0016, 1.0, 4], 0]
# pub rule, absolute arm dominant (printed=0.01: abs bound 7e-5 > rel 1.5e-5)
expect of ["pub.abs.inside", pub_tol_ok of [0.01006, 0.01, 4], 1]
expect of ["pub.abs.outside", pub_tol_ok of [0.01008, 0.01, 4], 0]
# pub rule, pure absolute at a coarser print precision (printed=0, 2 decimals)
expect of ["pub.abs2.inside", pub_tol_ok of [0.0069, 0.0, 2], 1]
expect of ["pub.abs2.outside", pub_tol_ok of [0.0071, 0.0, 2], 0]

# rel rule at the two tolerances the estimator grid uses
expect of ["rel.1pct.inside", rel_tol_ok of [10.099, 10.0, 0.01], 1]
expect of ["rel.1pct.outside", rel_tol_ok of [10.101, 10.0, 0.01], 0]
expect of ["rel.5pct.inside", rel_tol_ok of [10.499, 10.0, 0.05], 1]
expect of ["rel.5pct.outside", rel_tol_ok of [10.501, 10.0, 0.05], 0]

# abs rule at the solver-exactness scale
expect of ["abs.inside", abs_tol_ok of [0.9e-10, 0.0, exact_tol of null], 1]
expect of ["abs.outside", abs_tol_ok of [1.1e-10, 0.0, exact_tol of null], 0]
expect of ["abs.exact_tol_pinned", exact_tol of null, 1e-10]

print of f"CHECKS_RUN {checks_run}"
print of f"FAILURES {failures}"
if checks_run != 13:
    print of f"FAIL harness: expected exactly 13 checks, ran {checks_run}"
    exit of 1
if failures > 0:
    exit of 1
