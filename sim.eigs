# sim.eigs — rung 1's longitudinal model. The physics lives in
# sim_core.eigs (no imports, so it can be loaded by an UNARMED program);
# this file adds the two functions that need linear algebra and
# re-exports the whole surface, so existing consumers load one file as
# before. See sim_core.eigs's header for why the split exists.

load_file of "sim_core.eigs"
import linalg

define trim_solve(P) as:
    local x is [0.0, 0.0, 0.0]
    local it is 0
    local res is trim_residual of [x, P]
    loop while it < 25:
        local J is []
        for j in range of 3:
            local h is 1e-7
            if j == 2:
                h is 1.0
            local xp is [x[0], x[1], x[2]]
            xp[j] is xp[j] + h
            local rp is trim_residual of [xp, P]
            append of [J, [(rp[0] - res[0]) / h, (rp[1] - res[1]) / h, (rp[2] - res[2]) / h]]
        # J columns were built per unknown; transpose to rows-of-equations.
        local Jt is linalg.mat_transpose of (J)
        local step is linalg.solve_linear of [Jt, [0.0 - res[0], 0.0 - res[1], 0.0 - res[2]]]
        for j in range of 3:
            x[j] is x[j] + step[j]
        res is trim_residual of [x, P]
        local rmag is (abs of res[0]) + (abs of res[1]) + (abs of res[2])
        if rmag < 1e-13:
            it is 25
        it is it + 1
    local Pt is P
    Pt.thrust is x[2]
    return {"alpha": x[0], "de": x[1], "thrust": x[2], "P": Pt,
            "state": trim_state of [x[0], P.u0], "residual": res}

# Piecewise-constant elevator schedule: [[t_until, de], ...]; the last
# entry's t_until should cover the run. Stage times of the integrator
# read the schedule directly, so switch times aligned to step boundaries
# are exact.
define sp_subspace_ic(A, ph_re, ph_im, tstate, wamp) as:
    return mode_ic of [A, ph_re, ph_im, tstate, 1, wamp]

# The same construction, but normalised on a CHOSEN channel. Which channel
# matters enormously: the short period is w-dominant, so scaling its
# eigenvector to a given w is benign; the phugoid is u-DOMINANT
# (|v_u/v_w| = 6.75 on the annihilator column actually used), so
# normalising it on w over-scales the excitation 6.75x and flies the
# aircraft through complete pitch loops. (The raw column's own
# normalisation is arbitrary, which is why demanding w = 5.0 landed at a
# scale factor of 938 — that 938 is a scale, NOT a component ratio, as
# the first draft of this comment claimed.) Rung 2's lat_mode_ic already took
# a scale index for exactly this reason; rung 1's helper did not, and rung
# 3's first draft inherited the gap (found by round-1 review, 2026-08-25:
# a "phugoid" run that looped 7 times with airspeed swinging negative).
define mode_ic(A, kill_re, kill_im, tstate, scale_idx, amp) as:
    local A2 is linalg.mat_mul of [A, A]
    local B is linalg.mat_add of [A2, linalg.mat_add of [linalg.mat_scale of [A, 0.0 - 2.0 * kill_re], linalg.mat_scale of [linalg.mat_identity of 4, kill_re * kill_re + kill_im * kill_im]]]
    local v is []
    for i in range of 4:
        append of [v, B[i][1]]
    local scale is amp / (abs of v[scale_idx])
    local ic is []
    for i in range of 4:
        append of [ic, tstate[i] + v[i] * scale]
    return ic

# Central-difference Jacobian of deriv() at a state (S0 parity oracle).
# h per component scaled to the state's magnitude.
